# env.example — יועץ הרכב של שטראוס
# העתק ל-.env.local ומלא ערכים אמיתיים. אין להכניס סודות אמיתיים לקובץ זה או ל-git.
# כל הסודות נטענים בצד שרת בלבד (ללא NEXT_PUBLIC).

# --- מסד נתונים (Postgres / Supabase) ---
# DATABASE_URL: חיבור האפליקציה - חייב להיות תפקיד מוגבל (strauss_app) הכפוף ל-RLS,
# ללא BYPASSRLS/DDL. זהו המסלול התקין בפרודקשן.
# דוגמה: postgresql://strauss_app:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
# MIGRATION_DATABASE_URL: חיבור בעלים/אדמין להרצת מיגרציות בלבד (נפרד מהאפליקציה).
# דוגמה: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
MIGRATION_DATABASE_URL=
# פיתוח מקומי בלבד: אחסון קבצים במקום Postgres. בפרודקשן אין מעבר שקט - חובה DATABASE_URL.
STRAUSS_ALLOW_FILE_STORE=

# --- Supabase (Auth/Storage/Realtime; לשלבים הבאים) ---
SUPABASE_URL=
# מפתח ציבורי (anon/publishable) - נדרש להתחברות. בלעדיו האתר חסום בכוונה. ראו docs/auth-setup.md
SUPABASE_ANON_KEY=
# מפתח service-role: שימוש מוגבל למודול admin/worker בלבד. לעולם לא בלקוח.
SUPABASE_SERVICE_ROLE_KEY=
# סיסמת חשבון ההדגמה (צד שרת בלבד); נמסרת לשופטות בנפרד ולא נשמרת ב-repo.
DEMO_LOGIN_CODE=

# --- דואר (Resend; שלב הנציג/התראות) ---
RESEND_API_KEY=
MAIL_FROM_DOMAIN=
MAIL_FROM_ADDRESS=

# --- מודל שיחה (Claude / Anthropic) ---
# רשימת מפתחות Claude לפי סדר עדיפות. כשמפתח נכשל (חיוב/מכסה) הוא נכנס ל-cooldown
# של 10 דקות ומפתח _2, _3... משמש במקומו. Claude הוא ברירת המחדל; Gemini הוא fallback.
CLAUDE_API_KEY_1=
CLAUDE_API_KEY_2=
CLAUDE_API_KEY_3=
CLAUDE_API_KEY_4=
CLAUDE_API_KEY_5=
# שמות ישנים — נשמרים לתאימות לאחור (MODEL_API_KEY פועל עדיין אם CLAUDE_API_KEY_1 ריק)
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_CHAT_ID=
MODEL_EXTRACTION_ID=

# --- מודל חילוץ תלושים + Fallback שיחה (Gemini / Google) ---
# Gemini משמש גם: (א) חילוץ תלושי שכר, (ב) fallback לשיחה כשכל מפתחות Claude נכשלו.
# הוסף עד 5 מפתחות; round-robin דולג על מפתחות ב-cooldown.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# שמות ישנים — נשמרים לתאימות לאחור
MODEL_API_KEY3=
MODEL_API_KEY2=

# --- כללי ---
APP_BASE_URL=http://localhost:3000

# --- אחסון תלושים (Supabase Storage) ---
# אם SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY מוגדרים, תלושים נשמרים ב-Supabase Storage
# (bucket פרטי בשם "payslips") במקום בדיסק המקומי. נדרש ליצור bucket פרטי בשם payslips.
# ללא המפתחות - נשמר מקומית ב-data/uploads (פיתוח בלבד; לא לפריסה).
# מפתח Gemini (Google) לחילוץ תלושים בלבד; השיחה נשארת על MODEL_API_KEY (Claude).
# MODEL_API_KEY3 הוא המפתח הפעיל לחילוץ; אם אינו מוגדר, נופלים חזרה ל-MODEL_API_KEY2.
MODEL_API_KEY2=
MODEL_API_KEY3=
EXTRACTION_MODEL_ID=gemini-3.8-flash

# --- תמלול דיבור (STT) לקומפוזר: Groq Whisper ---
# מכסה חינמית *נפרדת* מ-Gemini/Claude, כך שהדיבור אינו שוחק את מכסת חילוץ
# התלושים או את תקציב השיחה. מפתח חינמי: https://console.groq.com (ללא כרטיס).
# אם המשתנה ריק - כפתור המיקרופון פשוט אינו מוצג (אין יכולת "מדומה").
# מגבלות המכסה החינמית: ~20 בקשות/דקה, 2,000/יום, ~8 שעות אודיו ביום.
TRANSCRIBE_API_KEY=
# ברירת מחדל: whisper-large-v3-turbo (רב-לשוני, תומך עברית).
TRANSCRIBE_MODEL_ID=whisper-large-v3-turbo

# --- גיבוי חילוץ באמצעות Claude (כבוי כברירת מחדל) ---
# מופעל רק כש-PAYSLIP_CLAUDE_FALLBACK=1. בשימוש: אם מכסת Gemini נוצלה, החילוץ
# ינסה דרך Claude הקיים (MODEL_API_KEY) בכפוף לתקרות. עלות בפועל (לא חינמי).
PAYSLIP_CLAUDE_FALLBACK=
# תקרת עמודי PDF לגיבוי (ברירת מחדל 3). תמונה = עמוד אחד.
PAYSLIP_CLAUDE_MAX_PAGES=
# תקרת עלות מצטברת (USD) לגיבוי Claude לכל חיי התהליך (ברירת מחדל 0.5).
PAYSLIP_CLAUDE_MAX_USD=

# --- התראות מייל מהאפליקציה (SMTP ברמת האפליקציה; נפרד מ-SMTP של Supabase Auth) ---
# אותם פרטי Gmail עם סיסמת אפליקציה. אין צורך ב-Resend או בדומיין.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# כתובת השולח המוצגת (ברירת מחדל: SMTP_USER). לדוגמה: "שטראוס · יועץ הרכב <you@gmail.com>"
MAIL_FROM=
# סוד להגנת ה-cron של עיבוד ההתראות. Vercel Cron שולח אותו כ-Authorization: Bearer.
CRON_SECRET=

# --- התנסות כנציג להדגמה (ראו docs/representative-access.md) ---
# כבוי כברירת מחדל. "1" מפעיל התנסות מוגבלת לכל משתמש מחובר: פניות בדיקה פיקטיביות + פניות שהוא
# צירף בעצמו. אינו נותן הרשאת נציג ארגונית. כיבוי (מחיקה/0) חוסם גם סשנים קיימים. שינוי דורש Redeploy.
REP_DEMO_ACCESS_ENABLED=
