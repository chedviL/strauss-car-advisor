# env.example — יועץ הרכב של שטראוס
# העתק ל-.env.local ומלא ערכים אמיתיים. אין להכניס סודות אמיתיים לקובץ זה או ל-git.
# כל הסודות נטענים בצד שרת בלבד (ללא NEXT_PUBLIC).

# --- מסד נתונים (Postgres / Supabase) ---
# DATABASE_URL: חיבור האפליקציה - חייב להיות תפקיד מוגבל (strauss_app) הכפוף ל-RLS,
# ללא BYPASSRLS/DDL. זהו המסלול התקין בפרודקשן.
# דוגמה: postgresql://strauss_app:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
# MIGRATION_DATABASE_URL: חיבור בעלים/אדמין להרצת מיגרציות בלבד (נפרד מהאפליקציה).
# דוגמה: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
MIGRATION_DATABASE_URL=
# פיתוח מקומי בלבד: אחסון קבצים במקום Postgres. בפרודקשן אין מעבר שקט - חובה DATABASE_URL.
STRAUSS_ALLOW_FILE_STORE=

# --- Supabase (Auth/Storage/Realtime; לשלבים הבאים) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# מפתח service-role: שימוש מוגבל למודול admin/worker בלבד. לעולם לא בלקוח.
SUPABASE_SERVICE_ROLE_KEY=

# --- דואר (Resend; שלב הנציג/התראות) ---
RESEND_API_KEY=
MAIL_FROM_DOMAIN=
MAIL_FROM_ADDRESS=

# --- מודל שיחה/חילוץ (O8 - נבחר ב-eval, אינו מקודד קשיח) ---
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_CHAT_ID=
MODEL_EXTRACTION_ID=

# --- כללי ---
APP_BASE_URL=http://localhost:3000